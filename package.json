{
  "name": "nevela",
  "version": "0.5.0",
  "private": true,
  "description": "Nevela: Laravel as the authority, Flare's Next.js frontend as the UI, one resource description driving both.",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "create-nevela": "packages/create-nevela/index.mjs"
  },
  "scripts": {
    "create": "node packages/create-nevela/index.mjs",
    "test:laravel": "cd packages/laravel && vendor/bin/phpunit",
    "test:release": "node --test scripts/release.test.mjs",
    "release": "node scripts/release.mjs",
    "docs:dev": "pnpm --filter nevela-docs dev",
    "docs:build": "pnpm --filter nevela-docs build",
    "split:laravel": "node scripts/split-laravel.mjs",
    "test:create": "node --test packages/create-nevela/packagist.test.mjs packages/create-nevela/cli.test.mjs"
  },
  "license": "MIT",
  "author": "Mark Cole MUKISA"
}

---
import { Image } from "astro:assets";
import { Code } from "@astrojs/starlight/components";
import { siFacebook, siInstagram, siLinkedin, siTiktok, siWhatsapp, siX } from "simple-icons";
import portrait from "../assets/markcole-mukisa.jpg";
import { NEVELA_VERSION, RELEASE_HEADLINE, RELEASE_URL, REPO_URL } from "../version";
/**
 * The docs home page. One idea carries it: describe a resource once, and Nevela writes
 * both sides — the Laravel API and the Next.js dashboard. The layout and styles are
 * Flare's landing page (MIT), with Nevela's content.
 */
/**
 * The person who made Nevela, for the section that says why.
 *
 * Every link is here and nowhere else. The icons are each network's own mark, from
 * simple-icons, drawn in the page's ink so six brands sit together as one row.
 */
const creator = {
  name: "MarkCole MUKISA",
  role: "Creator of Nevela Framework",
  socials: [
    { label: "WhatsApp", href: "https://wa.me/256702262806", icon: siWhatsapp },
    { label: "X", href: "https://x.com/MarkColeMUKISA", icon: siX },
    { label: "Facebook", href: "https://www.facebook.com/profile.php?id=61578393883785", icon: siFacebook },
    { label: "Instagram", href: "https://www.instagram.com/markcolemukisa/", icon: siInstagram },
    { label: "LinkedIn", href: "https://www.linkedin.com/in/mark-cole-mukisa-3247a7334/", icon: siLinkedin },
    { label: "TikTok", href: "https://www.tiktok.com/@markcolemukisa", icon: siTiktok },
  ],
};

const install = [
  { id: "install", label: "Install", command: "npm install -g create-nevela" },
  { id: "new", label: "New app", command: "nevela new my-app" },
  { id: "resource", label: "Add a resource", command: 'nevela resource Product --fields="name:string, sku:string!, price:money"' },
  { id: "seed", label: "Seed", command: "nevela seed Product --count=1000" },
  { id: "upgrade", label: "Upgrade", command: "nevela upgrade" },
];

const generated = [
  { path: "nevela/resources/contact.json", what: "Descriptor" },
  { path: "app/Models/Contact.php", what: "Eloquent model" },
  { path: "database/migrations/…_create_contacts_table.php", what: "Migration" },
  { path: "app/Http/Requests/Nevela/ContactRequest.php", what: "Validation" },
  { path: "app/Http/Controllers/Api/ContactController.php", what: "REST API" },
  { path: "app/Policies/ContactPolicy.php", what: "Authorization" },
  { path: "routes/nevela.php", what: "Routes" },
  { path: "web: resources/contact.resource.ts", what: "Dashboard descriptor" },
  { path: "web: app/dashboard/contacts/page.tsx", what: "Table, forms, detail" },
];

const stack = ["Laravel", "Eloquent", "Sanctum", "Next.js 16", "React 19", "Flare dashboard", "Tailwind CSS"];

const batteries = [
  { name: "REST API", body: "List, read, create, update, replace and delete for every resource, with paging, sorting, search and filters.", href: "/reference/api/", icon: "bolt" },
  { name: "Validation", body: "A Laravel form request per resource. Its messages show next to the right field in the dashboard.", href: "/concepts/field-types/", icon: "shield" },
  { name: "Dashboard", body: "Tables, stats, forms, detail pages, import and export for every resource, from its descriptor.", href: "/guides/web-app/", icon: "grid" },
  { name: "Authorization", body: "A Laravel policy per resource. Laravel decides; the dashboard only shows the answer.", href: "/guides/policies/", icon: "key" },
  { name: "Sign-in", body: "Sanctum tokens kept in an httpOnly cookie. The browser never sees the token.", href: "/guides/authentication/", icon: "mail" },
  { name: "Database", body: "Eloquent models with UUID ids and a migration you can read, on any database Laravel supports.", href: "/concepts/resources/#what-gets-generated", icon: "db" },
  { name: "Seeding", body: "Fill a resource with plausible records in one command, and see how long it took.", href: "/guides/seeding/", icon: "wave" },
  { name: "Your code is kept", body: "Regeneration rewrites only its marked blocks, and tells you when you edited inside one.", href: "/concepts/regeneration/#your-code-is-kept", icon: "box" },
];

const generators = [
  {
    id: "create",
    label: "nevela new",
    command: "nevela new my-app",
    lead: "A new app in one command: a Laravel API and a Next.js dashboard, installed and connected.",
    out: [
      ["✔", "Creating the Laravel app"],
      ["✔", "Installing Nevela and token sign-in"],
      ["✔", "Setting up the database"],
      ["✔", "Installing dashboard packages (pnpm)"],
      ["✔", "Created my-app"],
      ["", "Sign in with admin@example.com / password"],
    ],
    href: "/start/quickstart/",
  },
  {
    id: "resource",
    label: "nevela resource",
    command: 'nevela resource Product --fields="name:string, sku:string!, price:money, kind:enum(stock|digital)"',
    lead: "Describe a resource once. Nevela writes the Laravel side and the dashboard side from it.",
    out: [
      ["created", "app/Models/Product.php"],
      ["created", "database/migrations/…_create_products_table.php"],
      ["created", "app/Http/Requests/Nevela/ProductRequest.php"],
      ["created", "app/Http/Controllers/Api/ProductController.php"],
      ["created", "app/Policies/ProductPolicy.php"],
      ["created", "../web/resources/product.resource.ts"],
      ["created", "../web/app/dashboard/products/page.tsx"],
    ],
    href: "/reference/commands/#nevela-resource",
  },
  {
    id: "generate",
    label: "nevela generate",
    command: "nevela generate",
    lead: "Change the descriptor and run it again. Generated blocks follow; your own code stays where it is.",
    out: [
      ["updated", "app/Models/Product.php"],
      ["updated", "app/Http/Requests/Nevela/ProductRequest.php"],
      ["exists (yours)", "app/Policies/ProductPolicy.php"],
      ["updated", "../web/resources/product.resource.ts"],
      ["exists (yours)", "../web/app/dashboard/products/page.tsx"],
    ],
    href: "/reference/commands/#nevela-generate",
  },
  {
    id: "seed",
    label: "nevela seed",
    command: "nevela seed Product --count=1000",
    lead: "Fill a resource with records that follow its descriptor, timed.",
    out: [
      ["info", "Seeded 1,000 Products in 114 ms (8,809 rows/s)."],
      ["", "Products in the database .......... 1,000"],
    ],
    href: "/reference/commands/#nevela-seed",
  },
];

const examples = [
  {
    id: "descriptor",
    label: "Descriptor",
    title: "nevela/resources/product.json",
    lang: "json",
    code: `{
    "name": "Product",
    "icon": "package",
    "group": "Catalogue",
    "fields": {
        "name": { "kind": "string" },
        "sku": { "kind": "string", "unique": true },
        "price": { "kind": "float", "format": "money" },
        "kind": { "kind": "enum", "options": ["stock", "digital"] },
        "notes": { "kind": "text", "required": false }
    }
}`,
  },
  {
    id: "policy",
    label: "Policy",
    title: "app/Policies/ProductPolicy.php",
    lang: "php",
    code: `class ProductPolicy
{
    // A permission, held through a role. Laravel checks it on every request,
    // and the dashboard hides what a person can't use.
    public function delete(User $user, Product $product): bool
    {
        return $user->can('products.delete');
    }
}`,
  },
  {
    id: "model",
    label: "Your code",
    title: "app/Models/Product.php",
    lang: "php",
    code: `class Product extends Model
{
    // nevela:generated:start hash=4f1c2a9b7e31
    protected $fillable = ['name', 'sku', 'price', 'kind', 'notes'];
    // nevela:generated:end

    // Yours. Regeneration never touches what is outside the markers.
    public function scopeDigital($query)
    {
        return $query->where('kind', 'digital');
    }
}`,
  },
  {
    id: "api",
    label: "API",
    title: "Any HTTP client",
    lang: "bash",
    code: `curl -g "http://127.0.0.1:8000/api/products?sort=-price&q=lamp&filter[kind]=stock" \\
  -H "Accept: application/json" -H "Authorization: Bearer $TOKEN"`,
  },
];

const faq = [
  {
    q: "Is it production-ready?",
    a: "Not yet. Nevela is at 0.x: the generator, the API and the dashboard work end to end and are tested on every change, but relations, file uploads and account pages are still to come, and things can change between minor versions.",
  },
  {
    q: "Where do the rules live?",
    a: "In Laravel only. Validation is a form request, authorization is a policy, and the dashboard shows what Laravel answers. No rule is written twice.",
  },
  {
    q: "Can I edit the generated code?",
    a: "Yes. Generated code lives inside marked blocks; everything outside them is yours and is never touched. If you edit inside a block, Nevela skips that file and tells you instead of overwriting it.",
  },
  {
    q: "How does it relate to Flare?",
    a: "The dashboard is Flare's Next.js frontend by Muke Johnbaptist, used under the MIT license. Nevela replaces its database and sign-in layer with calls to Laravel, and generates Flare's resource descriptors from Laravel.",
  },
  {
    q: "Which databases work?",
    a: "Any that Laravel supports: SQLite, MySQL, MariaDB, PostgreSQL and SQL Server. The Laravel app ships set up for SQLite, which needs no installation.",
  },
];
---

<div class="fl-landing not-content">
  <!-- Hero -->
  <section class="fl-hero" aria-labelledby="fl-hero-title">
    <div class="fl-hero-grid" aria-hidden="true"></div>
    <a class="fl-pill" href={RELEASE_URL}>
      <span class="fl-pill-tag">v{NEVELA_VERSION}</span>
      <span class="fl-pill-text">{RELEASE_HEADLINE}</span>
    </a>
    <h1 id="fl-hero-title" class="fl-hero-title">
      <span class="fl-line">The fullstack framework</span>
      <span class="fl-line fl-ember-text">for Laravel and Next.js</span>
    </h1>
    <p class="fl-hero-lead">
      Describe a resource once. Nevela writes the table, the API, the validation and the policy in Laravel,
      and the dashboard screens in Next.js. Laravel stays the only place your rules live.
    </p>
    <div class="fl-actions">
      <a class="fl-btn fl-btn-primary" href="/start/quickstart/">Start building</a>
      <a class="fl-btn fl-btn-quiet" href={REPO_URL}>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" /></svg>
        View on GitHub
      </a>
    </div>

    <div class="fl-install" data-tabs>
      <div class="fl-install-tabs" role="tablist" aria-label="Install the command, create an app, then add to it">
        {install.map((item, index) => (
          <button role="tab" id={`fl-i-${item.id}`} aria-controls={`fl-ip-${item.id}`} aria-selected={index === 0 ? "true" : "false"} tabindex={index === 0 ? 0 : -1}>
            {item.label}
          </button>
        ))}
      </div>
      {install.map((item, index) => (
        <div class="fl-install-line" role="tabpanel" id={`fl-ip-${item.id}`} aria-labelledby={`fl-i-${item.id}`} hidden={index !== 0}>
          <span class="fl-prompt" aria-hidden="true">$</span>
          <code>{item.command}</code>
          <button class="fl-copy" data-copy={item.command} aria-label="Copy command">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2" /><path d="M5 15V5a2 2 0 0 1 2-2h10" /></svg>
            <span class="fl-copy-label">Copy</span>
          </button>
        </div>
      ))}
    </div>
  </section>

  <!-- The idea, shown: one command in, both sides out -->
  <div class="fl-frame">
    <section class="fl-demo fl-rail" aria-label="What nevela:resource writes">
      <div class="fl-demo-pane">
        <div class="fl-pane-head">
          <span class="fl-dot" aria-hidden="true"></span>
          Terminal, in the Laravel app
          <span class="fl-pane-note">you write</span>
        </div>
        <pre class="fl-code"><code><span class="f">php artisan</span> nevela:resource Contact \
  --fields=<span class="s">"name:string,
            email:email!,
            phone:tel?,
            status:enum(lead|customer)"</span>

<span class="f">php artisan</span> migrate</code></pre>
      </div>
      <div class="fl-demo-arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </div>
      <div class="fl-demo-pane">
        <div class="fl-pane-head">
          <span class="fl-dot fl-dot-ember" aria-hidden="true"></span>
          Laravel and Next.js
          <span class="fl-pane-note">Nevela writes</span>
        </div>
        <ol class="fl-gen">
          {generated.map((file, index) => (
            <li style={`--i:${index}`}>
              <span class="fl-plus" aria-hidden="true">+</span>
              <span class="fl-path">{file.path}</span>
              <span class="fl-what">{file.what}</span>
            </li>
          ))}
        </ol>
        <p class="fl-demo-foot">Edit the descriptor and run <code>nevela:generate</code>: every file follows, and your own code outside the generated blocks is kept.</p>
      </div>
    </section>

    <section class="fl-stack fl-rail" aria-label="Built on">
      <span class="fl-stack-label">Built on</span>
      <ul>
        {stack.map((name) => <li>{name}</li>)}
      </ul>
    </section>

    <!-- 01 What you get -->
    <section class="fl-section fl-rail" aria-labelledby="fl-create">
      <p class="fl-step"><span>[ 01 / 03 ]</span> Describe</p>
      <div class="fl-section-head">
        <h2 id="fl-create">Everything a resource needs,<br /><span class="fl-ember-text">from one description</span></h2>
        <p>
          <code>nevela:resource</code> turns a list of fields into a working feature on both sides: the Laravel
          code that owns the data, and the screens people use to work with it.
        </p>
      </div>
      <ul class="fl-batteries">
        {batteries.map((item) => (
          <li>
            <a href={item.href}>
              <span class="fl-icon" aria-hidden="true">
                {item.icon === "key" && <svg viewBox="0 0 24 24"><circle cx="8" cy="15" r="4" /><path d="M10.8 12.2 20 3M17 6l3 3M14.5 8.5l2 2" /></svg>}
                {item.icon === "db" && <svg viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="8" ry="3" /><path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3" /></svg>}
                {item.icon === "grid" && <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M3 9h18M9 21V9" /></svg>}
                {item.icon === "shield" && <svg viewBox="0 0 24 24"><path d="M12 3 4 6v6c0 5 3.4 8 8 9 4.6-1 8-4 8-9V6l-8-3Z" /><path d="m9 12 2 2 4-4" /></svg>}
                {item.icon === "box" && <svg viewBox="0 0 24 24"><path d="M21 8 12 3 3 8v8l9 5 9-5V8Z" /><path d="m3 8 9 5 9-5M12 13v8" /></svg>}
                {item.icon === "mail" && <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>}
                {item.icon === "bolt" && <svg viewBox="0 0 24 24"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z" /></svg>}
                {item.icon === "wave" && <svg viewBox="0 0 24 24"><path d="M2 12h3l3-7 4 14 3-9 2 2h5" /></svg>}
              </span>
              <span class="fl-battery-name">{item.name}</span>
              <span class="fl-battery-body">{item.body}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- 02 Generate -->
    <section class="fl-section fl-rail" aria-labelledby="fl-generate">
      <p class="fl-step"><span>[ 02 / 03 ]</span> Generate</p>
      <div class="fl-section-head">
        <h2 id="fl-generate">One command to start,<br /><span class="fl-ember-text">one for each thing you add</span></h2>
        <p>Each one writes plain, readable files into your project. Change them, or regenerate: Nevela keeps your edits and tells you when it skipped a file.</p>
      </div>

      <div class="fl-gens" data-tabs>
        <div class="fl-gens-tabs" role="tablist" aria-label="Commands">
          {generators.map((item, index) => (
            <button role="tab" id={`fl-g-${item.id}`} aria-controls={`fl-gp-${item.id}`} aria-selected={index === 0 ? "true" : "false"} tabindex={index === 0 ? 0 : -1}>
              {item.label}
            </button>
          ))}
        </div>
        {generators.map((item, index) => (
          <div class="fl-gens-panel" role="tabpanel" id={`fl-gp-${item.id}`} aria-labelledby={`fl-g-${item.id}`} hidden={index !== 0}>
            <div class="fl-gens-copy">
              <p>{item.lead}</p>
              <a href={item.href} class="fl-link">Read the reference</a>
            </div>
            <div class="fl-terminal">
              <div class="fl-terminal-cmd">
                <span class="fl-prompt" aria-hidden="true">$</span>
                <code>{item.command}</code>
              </div>
              <ul class="fl-terminal-out">
                {item.out.map(([status, text]) => (
                  <li>{status && <span class="fl-created">{status}</span>} {text}</li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>

      <div class="fl-examples" data-tabs>
        <p class="fl-examples-title">And what you write stays small</p>
        <div class="fl-gens-tabs" role="tablist" aria-label="Code examples">
          {examples.map((example, index) => (
            <button role="tab" id={`fl-x-${example.id}`} aria-controls={`fl-xp-${example.id}`} aria-selected={index === 0 ? "true" : "false"} tabindex={index === 0 ? 0 : -1}>
              {example.label}
            </button>
          ))}
        </div>
        {examples.map((example, index) => (
          <div role="tabpanel" id={`fl-xp-${example.id}`} aria-labelledby={`fl-x-${example.id}`} hidden={index !== 0}>
            <Code code={example.code} lang={example.lang} title={example.title} />
          </div>
        ))}
      </div>
    </section>

    <!-- 03 How it fits together -->
    <section class="fl-section fl-rail" aria-labelledby="fl-ship">
      <p class="fl-step"><span>[ 03 / 03 ]</span> Run</p>
      <div class="fl-section-head">
        <h2 id="fl-ship">Laravel decides,<br /><span class="fl-ember-text">the dashboard shows</span></h2>
        <p>The Next.js server holds the sign-in token and calls Laravel for everything. The browser never talks to Laravel, and no rule is written twice.</p>
      </div>
      <div class="fl-ship">
        <div class="fl-terminal fl-terminal-tall">
          <div class="fl-terminal-cmd">
            <span class="fl-prompt" aria-hidden="true">$</span>
            <code>curl -X POST /api/products -d '{"{"}"name": "", "sku": "L-1"{"}"}'</code>
          </div>
          <ul class="fl-terminal-out">
            <li><span class="fl-step-mark">422</span> Validation failed.</li>
            <li class="fl-dim">&nbsp;&nbsp;name: The name field is required.</li>
            <li class="fl-dim">&nbsp;&nbsp;sku: The sku has already been taken.</li>
            <li class="fl-dim">&nbsp;&nbsp;price: The price field is required.</li>
            <li class="fl-ok">The same messages appear next to each field in the dashboard form.</li>
          </ul>
        </div>
        <div class="fl-ship-side">
          <div class="fl-share">
            <p class="fl-share-title">One API, any client</p>
            <p>The dashboard uses the same REST API you can call from a mobile app, a script or another service.</p>
            <a href="/reference/api/" class="fl-link">REST API reference</a>
          </div>
          <div class="fl-share">
            <p class="fl-share-title">Data to look at, straight away</p>
            <p>Seed a thousand records that follow the descriptor, and see the time it took.</p>
            <code class="fl-share-cmd">nevela seed Product</code>
            <a href="/reference/commands/#nevela-seed" class="fl-link">Seeding</a>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="fl-section fl-rail" aria-labelledby="fl-faq">
      <div class="fl-faq-grid">
        <h2 id="fl-faq" class="fl-faq-title">Questions</h2>
        <div class="fl-faq">
          {faq.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- The creator -->
    <section class="fl-section fl-rail fl-creator" aria-labelledby="fl-creator">
      <p class="fl-step"><span>[ The maker ]</span> Why Nevela exists</p>
      <div class="fl-creator-grid">
        <figure class="fl-creator-figure">
          <div class="fl-creator-frame">
            <Image src={portrait} alt={`${creator.name}, the creator of Nevela`} width={520} height={520} quality={82} loading="lazy" />
          </div>
          <figcaption>
            <span aria-hidden="true">nevela new</span> started here
          </figcaption>
        </figure>

        <div class="fl-creator-body">
          <h2 id="fl-creator">One place to change it.<br /><span class="fl-ember-text">That was the whole idea.</span></h2>
          <blockquote class="fl-creator-quote">
            <p>I built Nevela because I was tired of writing the same code over and over.</p>
            <p>
              Every project began with the same boilerplate. And every change meant flipping through folders and files, looking for one small piece
              I had already written somewhere else.
            </p>
            <p>
              I wanted a single source of truth for my applications: one place to describe a thing, and one place to change it. Now I describe a
              resource once, and minutes later the database, the API and the dashboard all agree.
            </p>
            <p>That is the framework I wanted to use. So I built it.</p>
          </blockquote>

          <div class="fl-creator-sign">
            <div>
              <p class="fl-creator-name">{creator.name}</p>
              <p class="fl-creator-role">{creator.role}</p>
            </div>
            <div class="fl-creator-follow">
              <p id="fl-creator-follow">Follow him on</p>
              <ul aria-labelledby="fl-creator-follow">
                {creator.socials.map((social) => (
                  <li>
                    <a href={social.href} target="_blank" rel="noopener noreferrer me" aria-label={`${creator.name} on ${social.label}`} title={social.label}>
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d={social.icon.path} /></svg>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Close -->
    <section class="fl-close fl-rail" aria-labelledby="fl-close">

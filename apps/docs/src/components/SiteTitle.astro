---
import Default from "@astrojs/starlight/components/SiteTitle.astro";
import { NEVELA_VERSION, RELEASE_URL } from "../version";
import SiteNav from "./SiteNav.astro";
---

<div class="fl-title">
  <Default />
  <a class="fl-version" href={RELEASE_URL} title={`Docs for Nevela ${NEVELA_VERSION}: release notes`}>v{NEVELA_VERSION}</a>
  <SiteNav place="header" />
</div>

<style>
  .fl-title {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .fl-version {
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1;
    padding: 0.3rem 0.5rem;
    border: 1px solid var(--fl-rule);
    border-radius: 999px;
    color: var(--fl-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .fl-version:hover {
    border-color: var(--fl-ember);
    color: var(--fl-ink);
  }

  /* On a phone, a page with no sidebar has its links in the header: they need the room, and
     the release banner below says the version. */
  @media (max-width: 29.99rem) {
    :global(:root:not([data-has-sidebar])) .fl-version {
      display: none;
    }
  }
</style>

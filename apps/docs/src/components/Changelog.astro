---
/**
 * The repository's CHANGELOG.md, rendered. Reading the file at build time means the
 * site and the repository cannot show different release notes.
 *
 * First a list of every release, week by week, each a version and the line that says what
 * it was about, linking to its entry. Then the entries themselves, as they are in the file.
 */
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import changelog from "../../../../CHANGELOG.md?raw";
import { byWeek, inline, releasesIn } from "../lib/changelog";

// From the first version heading on: the file's own title and introduction are for
// people reading it on GitHub.
const text = changelog.replace(/\r\n/g, "\n");
let releases = text.slice(text.indexOf("\n## ["));
// An empty Unreleased section is noise on a public page.
releases = releases.replace(/\n## \[Unreleased\]\s*(?=\n## \[|\n\[[^\]]+\]: |$)/, "\n");

const processor = await createMarkdownProcessor();
const { code } = await processor.render(releases);
// Each entry is found by its version: #v0.7.1. The id markdown gives it is made from
// the whole heading, date and all.
const html = code.replace(/<h2 id="[^"]*">((?:<a [^>]*>)?(\d+\.\d+\.\d+))/g, '<h2 id="v$2">$1');

const list = releasesIn(releases);
const weeks = byWeek(list);
---

{
  list.length > 0 && (
    <nav class="nv-weeks not-content" aria-labelledby="nv-weeks-title">
      <h2 id="nv-weeks-title">Releases by week</h2>
      <p class="nv-weeks-count">
        {list.length} {list.length === 1 ? "release" : "releases"}. Every line links to its full entry below.
      </p>
      {weeks.map((week) => (
        <section>
          <h3>
            {week.label}
            <span>
              {week.releases.length} {week.releases.length === 1 ? "release" : "releases"}
            </span>
          </h3>
          <ul>
            {week.releases.map((release) => (
              <li>
                <a href={`#v${release.version}`}>
                  <span class="nv-weeks-version">v{release.version}</span>
                  <span class="nv-weeks-headline" set:html={inline(release.headline)} />
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </nav>
  )
}

<div class="nv-changelog">
  <Fragment set:html={html} />
</div>

<style is:global>
  /* Global, and under these two names: the entries are HTML from the markdown file, which a scoped style can't reach. */
  .nv-weeks {
    margin-top: 2rem;
    padding: 1.5rem 1.75rem 1.25rem;
    border: 1px solid var(--fl-rule);
    border-radius: 0.75rem;
    background: var(--fl-surface);
  }

  .nv-weeks h2 {
    margin: 0;
    color: var(--fl-ink);
    font-size: 1.25rem;
    font-weight: 620;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .nv-weeks-count {
    margin: 0.375rem 0 0;
    color: var(--fl-muted);
    font-size: 0.9375rem;
  }

  .nv-weeks h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.625rem;
    margin: 1.5rem 0 0.375rem;
    color: var(--fl-ink);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .nv-weeks h3 span {
    color: var(--fl-muted);
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: 0;
  }

  .nv-weeks ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nv-weeks li a {
    display: grid;
    grid-template-columns: 4.25rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.25rem 0;
    color: var(--fl-body);
    text-decoration: none;
  }

  .nv-weeks-version {
    color: var(--fl-ember-strong);
    font-family: var(--sl-font-mono);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }

  .nv-weeks-headline {
    color: var(--fl-ink);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  /* A command in a headline is set in the code face and nothing more: a box around it would crowd a one-line list. */
  .nv-weeks-headline code {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font-family: var(--sl-font-mono);
    font-size: 0.8125rem;
  }

  .nv-weeks li a:hover .nv-weeks-headline,
  .nv-weeks li a:focus-visible .nv-weeks-headline {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* On a phone the card gives its width to the words. */
  @media (max-width: 30rem) {
    .nv-weeks {
      padding: 1.125rem 1rem 0.875rem;
    }

    .nv-weeks li a {
      grid-template-columns: 3.5rem minmax(0, 1fr);
      gap: 0.5rem;
    }
  }

  /* An entry arrived at from the list stops clear of the page's header. */
  .nv-changelog h2 {
    scroll-margin-top: 5.5rem;
  }

  /* The line under a version: what the release was about. Italic in the file, a subtitle here. */
  .nv-changelog h2 + p > em:only-child {
    color: var(--fl-ink);
    font-size: 1.0625rem;
    font-style: normal;
    font-weight: 500;
  }
</style>

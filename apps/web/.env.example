# Where Nevela's routes live in the Laravel app (apps/api): its address and the prefix,
# which is /api. Not the host alone: https://api.example.com/api, not https://api.example.com.
NEVELA_API_URL=http://127.0.0.1:8000/api

# The secret the dashboard and Laravel share, the same value as NEVELA_PROXY_SECRET in
# apps/api/.env. A new app has it in both already. The sign-in page says if they differ.
# NEVELA_PROXY_SECRET=

# Cloudflare Turnstile's site key, for a public form whose descriptor asks for the robot
# check. Its secret key goes in apps/api/.env as TURNSTILE_SECRET_KEY.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# The "Still there?" warning: after this long with no mouse, keyboard or touch, it counts
# down and signs out. Built in: rebuild after changing. 0 turns it off.
# NEXT_PUBLIC_SESSION_IDLE_MS=870000
# NEXT_PUBLIC_SESSION_COUNTDOWN_MS=30000

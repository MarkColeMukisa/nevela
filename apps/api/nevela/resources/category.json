{
    "$schema": "https://nevela.dev/schema/resource.v1.json",
    "name": "Category",
    "table": "categories",
    "slug": "categories",
    "label": "Category",
    "pluralLabel": "Categories",
    "icon": "tags",
    "group": "Catalogue",
    "fields": {
        "name": {
            "kind": "string"
        },
        "slug": {
            "kind": "string",
            "format": "slug",
            "unique": true
        },
        "image": {
            "kind": "file",
            "accept": [
                "image"
            ],
            "required": false
        }
    }
}

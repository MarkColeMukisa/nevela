{
    "$schema": "https://nevela.dev/schema/resource.v1.json",
    "name": "Product",
    "table": "products",
    "slug": "products",
    "label": "Product",
    "pluralLabel": "Products",
    "icon": "package",
    "group": "Catalogue",
    "fields": {
        "name": {
            "kind": "string"
        },
        "sku": {
            "kind": "string",
            "unique": true
        },
        "price": {
            "kind": "float",
            "format": "money"
        },
        "image": {
            "kind": "file",
            "accept": [
                "image"
            ],
            "profile": "product",
            "required": false
        },
        "categoryId": {
            "kind": "belongsTo",
            "target": "Category"
        },
        "active": {
            "kind": "boolean"
        },
        "kind": {
            "kind": "enum",
            "options": [
                "stock",
                "digital"
            ]
        },
        "notes": {
            "kind": "text",
            "required": false
        }
    }
}
